# ─── LegalEagle LMS — Production Environment ───────────────────────────────
# Copy this file to .env.production and fill in your values.
# Never commit .env.production to version control.

# API base URL (no trailing slash)
VITE_API_BASE_URL=https://api.yourdomain.com

# Set to false in production — static mode is for demos only
VITE_USE_STATIC_DATA=false

# true = sidebar nav loaded from /api/user/get/access/menu
VITE_DYNAMIC_NAV=true

# Disable debug logs in production
VITE_ENABLE_LOGS=false

# Set to true if all users must sign in via Microsoft SSO
VITE_FORCE_MICROSOFT_SSO=false

# Allow self-registration (usually false for law firms)
VITE_ENABLE_USER_REGISTRATION=false

# Microsoft Azure SSO (required if VITE_FORCE_MICROSOFT_SSO=true)
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=https://yourdomain.com

# OneDrive integration (optional)
VITE_ONEDRIVE_CLIENT_ID=

# Environment tag shown in browser title (dev/staging/production)
VITE_APP_ENV=production
