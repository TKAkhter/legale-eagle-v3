# ─── LegalEagle FE — Environment Variables ────────────────────────────────────
# Copy this file to .env.local and fill in values for your environment.
# Never commit .env.local to version control.

# ── Backend API ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://testapi.alshamsilegallms.com

# ── Data Mode ────────────────────────────────────────────────────────────────
# true  = use static JSON fixtures (src/data/static.ts), no backend needed
# false = call real backend APIs
VITE_USE_STATIC_DATA=true

# ── Navigation Mode ───────────────────────────────────────────────────────────
# true  = sidebar nav items come from /api/user/get/access/menu (dynamic, per-user)
# false = sidebar shows all items from config/navigation.ts (static, useful for dev)
# Default: true (dynamic) — set to false when developing without a backend
VITE_DYNAMIC_NAV=false

# ── Logging ───────────────────────────────────────────────────────────────────
# true  = show debug/info/warn/error logs in browser console
# false = silent (use in production)
VITE_ENABLE_LOGS=true

# ── Auth Feature Flags ────────────────────────────────────────────────────────
VITE_FORCE_MICROSOFT_SSO=false
VITE_ENABLE_USER_REGISTRATION=false

# ── Microsoft Azure (required for SSO + OneDrive) ────────────────────────────
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:3000
VITE_ONEDRIVE_CLIENT_ID=

# ── App Environment ───────────────────────────────────────────────────────────
VITE_APP_ENV=development
