# ─── API ─────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://testapi.alshamsilegallms.com

# ─── DATA MODE ───────────────────────────────────────────────────────────────
# true  = use static JSON fixtures in src/data/static.ts (no backend needed)
# false = call real APIs at VITE_API_BASE_URL
VITE_USE_STATIC_DATA=true

# ─── AUTH FEATURE FLAGS ───────────────────────────────────────────────────────
# Set VITE_FORCE_MICROSOFT_SSO=true to only show Microsoft login button
VITE_FORCE_MICROSOFT_SSO=false
# Set VITE_ENABLE_USER_REGISTRATION=true to show the Register page
VITE_ENABLE_USER_REGISTRATION=false

# ─── MICROSOFT / ONEDRIVE ────────────────────────────────────────────────────
# Required for SSO and OneDrive integration
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:3000
VITE_ONEDRIVE_CLIENT_ID=

# ─── APP ────────────────────────────────────────────────────────────────────
VITE_APP_ENV=development
