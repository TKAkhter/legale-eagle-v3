# ─── API ──────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://testapi.alshamsilegallms.com

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to true to show the Register page (self-signup flow)
VITE_ENABLE_USER_REGISTRATION=false
# Set to true to bypass email/password login and force Microsoft SSO
VITE_FORCE_MICROSOFT_SSO=false

# ─── Microsoft Azure (required when VITE_FORCE_MICROSOFT_SSO=true or OneDrive) ─
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:3000
# OneDrive integration (can be same as VITE_AZURE_CLIENT_ID)
VITE_ONEDRIVE_CLIENT_ID=

# ─── Environment ──────────────────────────────────────────────────────────────
# One of: development | staging | production
VITE_APP_ENV=development

# ─── Tolgee (optional — for live translation management) ──────────────────────
VITE_TOLGEE_API_URL=
VITE_TOLGEE_API_KEY=
